# This repo carries the public trash can map only. The other two maps in this
# working folder are built by the same script from their own CSVs and are kept
# out of it on purpose.
/debris-in-street/
/new-container-requests/
/data/debris in street.csv
/data/new container requests*.csv
/new-container-requests/Data_311_*.csv
/assets/template.html

# The receptacle export as delivered. data/public receptacles.csv is the same
# file under the name the build script reads, and that copy is tracked.
/As of *.csv

# Working files for the marker. assets/can-glyph.png -- the can lifted off its
# baked-in disc -- is what the map actually loads, and that is tracked.
/public-trashcan-locations/trash.png
/assets/can-marker.png

# faq/ is its own repository -- github.com/eesedla/trash-faq -- and happens to
# sit inside this working folder. Ignoring it keeps git from trying to swallow
# it as a submodule.
/faq/

# Records requests and other working spreadsheets. This repo is public, so
# nothing lands in it without being looked at first.
/Pub.Rec.*
*.xls
*.xlsx

.DS_Store
__pycache__/
*.pyc
